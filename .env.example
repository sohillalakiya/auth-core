# =============================================================================
# OIDC Provider Configuration
# =============================================================================

# The OIDC Provider Issuer URL (e.g., https://accounts.google.com)
# This will be used to discover the provider's configuration via
# .well-known/openid-configuration
OIDC_ISSUER=https://your-oidc-provider.com

# Client identifier registered with the OIDC provider
OIDC_CLIENT_ID=your-client-id

# Client secret (required for confidential clients, optional for public clients)
OIDC_CLIENT_SECRET=your-client-secret

# =============================================================================
# Application URLs
# =============================================================================

# The callback URL where the provider will redirect after authentication
# Must match exactly what's registered with the provider
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# The URL where the user should be redirected after logout
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# =============================================================================
# OAuth/OIDC Settings
# =============================================================================

# Space-separated list of OAuth scopes to request
# Standard OIDC scopes: openid (required), profile, email
OIDC_SCOPE=openid profile email

# =============================================================================
# Session Security
# =============================================================================

# Secret key for encrypting session cookies
# Generate with: openssl rand -base64 32
# Must be at least 32 characters long
SESSION_SECRET=your-random-32-character-secret-string

# =============================================================================
# Redis (Session Registry / Back-Channel Logout)
# =============================================================================

# Redis connection URL — required for back-channel logout and session invalidation
# Start Redis with: docker compose up -d  (maps to port 6380)
REDIS_URL=redis://localhost:6380

# =============================================================================
# DPoP — Demonstrating Proof-of-Possession (RFC 9449)
# =============================================================================

# Set to true to enable DPoP sender-constrained tokens.
# When enabled, an ES256 key pair is generated per login and a DPoP proof is
# sent on every token request. Requires the OIDC provider to support DPoP.
DPOP_ENABLED=false

# =============================================================================
# Email OTP Authentication (Gmail SMTP)
# =============================================================================

# Gmail SMTP host
SMTP_HOST=smtp.gmail.com

# SMTP port — 587 for STARTTLS (recommended for Gmail)
SMTP_PORT=587

# Gmail address used to send OTP emails
SMTP_USER=your-gmail@gmail.com

# Gmail App Password (not your account password).
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your Google account.
SMTP_PASS=your-app-password

# Optional: sender address shown in the From header (defaults to SMTP_USER)
# SMTP_FROM=no-reply@yourdomain.com

# =============================================================================
# Environment
# =============================================================================

# Node environment: development, production, or test
NODE_ENV=development
